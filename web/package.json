{
  "name": "webmux-web",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "arch:lint": "eslint src",
    "arch:deps": "depcruise src --ignore-known",
    "arch:dupes": "jscpd -c .jscpd.json --baseline .jscpd-baseline.json --fail-on-new-clones=0",
    "arch:unused": "knip",
    "arch:test": "vitest run --config vitest.config.ts test/architecture.test.ts",
    "arch:ratchet": "eslint src --prune-suppressions && depcruise src --baseline .dependency-cruiser-known-violations.json --baseline-mode shrink-only && pnpm run arch:dupes && jscpd -c .jscpd.json --baseline .jscpd-baseline.json --update-baseline && oxfmt eslint-suppressions.json .dependency-cruiser-known-violations.json .jscpd-baseline.json",
    "check:arch": "pnpm run arch:lint && pnpm run arch:deps && pnpm run arch:dupes && pnpm run arch:unused && pnpm run arch:test",
    "dev": "vite --host 127.0.0.1",
    "test": "pnpm run test:unit && pnpm run test:browser && pnpm run test:storybook && pnpm run test:e2e && pnpm run test:performance",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "screenshots": "node scripts/screenshots.mjs",
    "test:e2e:report": "playwright show-report playwright-report/e2e",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open",
    "check:storybook": "svelte-check --tsconfig .storybook/tsconfig.json",
    "build-storybook": "pnpm run check:storybook && storybook build",
    "test:storybook": "pnpm run build-storybook && playwright test --config playwright.storybook.config.ts",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@pierre/diffs": "1.3.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "svelte": "^5.57.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@iconify-json/tabler": "^1.2.42",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.64.1",
    "@shadcn/lint": "^0.2.3",
    "@storybook/svelte-vite": "10.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tabler/icons-svelte": "^3.49.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.72.0",
    "@vitest/browser-playwright": "^5.0.5",
    "bits-ui": "^2.19.5",
    "cn": "^0.5.0",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-svelte": "^3.23.1",
    "fflate": "0.8.3",
    "jscpd": "^5.4.2",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "paneforge": "^1.0.2",
    "playwright": "^1.64.1",
    "shadcn-svelte": "^1.7.0",
    "storybook": "10.6.2",
    "svelte-check": "^4.7.7",
    "svelte-eslint-parser": "^1.10.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unplugin-icons": "^24.0.0",
    "vaul-svelte": "1.0.0-next.7",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vitest-browser-svelte": "^3.1.0"
  }
}
